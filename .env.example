# Reference only -- this project has no dotenv loader, so nothing reads this file
# automatically. Copy the values you need into your shell (`export $(grep -v '^#' .env | xargs)`)
# or into your run configuration. For local dev, `docker/docker-compose.yml` plus
# `SPRING_PROFILES_ACTIVE=dev ./gradlew bootRun` already works with zero exports below --
# application-dev.yml supplies a default JWT_SECRET and points at the compose Postgres.
# These become required once you leave the dev profile (e.g. `prod`) or want to override a default.

# --- Required outside the dev profile (src/main/resources/application-prod.yml) ---
DATABASE_URL=jdbc:postgresql://localhost:5432/beduno
DATABASE_USERNAME=beduno
DATABASE_PASSWORD=beduno
JWT_SECRET=

# --- Optional, with defaults (src/main/resources/application.yml / application-prod.yml) ---
CORS_ALLOWED_ORIGINS=
BOOTSTRAP_ENABLED=false
BOOTSTRAP_AGENCY_NAME=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=Agency
BOOTSTRAP_ADMIN_LAST_NAME=Admin
BOOTSTRAP_ADMIN_LANGUAGE=PL
BEDUNO_SEED_ENABLED=false
BEDUNO_TIME_ZONE=Europe/Warsaw

# --- CI only -- NOT read by the Spring app, NOT set here in practice ---
# OPENROUTER_API_KEY lives in GitHub repo Settings -> Secrets and variables -> Actions,
# referenced by .github/workflows/pr-review.yml. Never put a real value in this file.
